# ─── Copiez ce fichier en .env (local) ou saisissez ces variables chez l'hébergeur. Ne jamais committer de vraies valeurs. ───

# Base PostgreSQL (Supabase : chaîne « Transaction pooler », port 6543)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# Connexion pour les migrations au déploiement (Supabase : « Session pooler », port 5432, compatible IPv4).

DATABASE_URL_DIRECT=
# Avec le pooler Supabase en mode transaction : DATABASE_PREPARE=false
DATABASE_PREPARE=
DATABASE_POOL_SIZE=5

# Adresse publique de l'application (sans « / » final) — sert aux liens d'invitation et aux retours OAuth
APP_URL=https://qg.exemple.fr

# Secrets générés par vous (commande : openssl rand -base64 32)
SESSION_SECRET=
VAULT_MASTER_KEY=      # exactement 32 octets en base64. PERDRE CETTE CLÉ = coffre-fort et jetons OAuth illisibles. Sauvegardez-la à part.
CRON_SECRET=           # protège /api/cron/quotidien

# Idées du jour (optionnel : sans clé, la page affiche « configuration manquante »)
ANTHROPIC_API_KEY=
AI_MODEL=

# E-mails d'invitation / réinitialisation (optionnel : sans clé, les liens s'affichent à l'administrateur)
RESEND_API_KEY=
MAIL_FROM="De l'Ombre à la Lumière <qg@exemple.fr>"

# Connexions aux plateformes (optionnel, chacune est indépendante)
GOOGLE_CLIENT_ID=      # Google Drive + YouTube
GOOGLE_CLIENT_SECRET=
META_APP_ID=           # Instagram
META_APP_SECRET=
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
